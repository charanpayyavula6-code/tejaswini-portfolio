# ==============================================================================
# TEJASWINI PORTFOLIO & IT ADMIN - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud Database (MongoDB Atlas) Configuration
# ------------------------------------------------------------------------------
# How to get your FREE MongoDB Atlas Cluster:
# 1. Sign up / Log in to https://cloud.mongodb.com
# 2. Create a Free Shared Cluster (M0 Sandbox - 512MB free forever).
# 3. Under 'Database Access', create a database user and password.
# 4. Under 'Network Access', add IP '0.0.0.0/0' (Allow access from anywhere / Vercel).
# 5. Click 'Connect' > 'Drivers' > Python > copy the connection URI and paste below:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/tejaswini_portfolio?retryWrites=true&w=majority
MONGODB_DB_NAME=tejaswini_portfolio
MONGODB_TIMEOUT_MS=4000

# ------------------------------------------------------------------------------
# 2. Security & Token Secrets
# ------------------------------------------------------------------------------
SECRET_KEY=tejaswini-portfolio-secret-key-2026-secure-token
CAPTCHA_SALT=captcha-salt-teja-secure-x99

# ------------------------------------------------------------------------------
# 3. Microservice Network Hosts
# ------------------------------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
FASTAPI_BASE_URL=http://127.0.0.1:8000
